# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.log

# Virtual Environments
venv/
.venv/
env/
ENV/

# Agent artifacts & temporary tools
.agents/

# Environment variables & secrets
.env
*.pem
*.key
*.cer
*.crt

# SQLite & local database
instance/
*.sqlite
*.sqlite3
*.db

# Temporary upload storage & archives
uploads/
temp/
*.tmp
resumeai-image.tar
*.tar

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large external dataset files (keep sample_resumes.csv tracked for tests)
data/UpdatedResumeDataSet.csv
data/*.pdf
data/*.docx

# Model cache & checkpoints (keep production joblib artifact and gitkeep)
model/*.pkl
!model/resume_classifier.joblib
!model/.gitkeep
