# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-replace-in-production-with-strong-random-token

# Database Configuration (Defaults to SQLite in local development)
DATABASE_URL=sqlite:///resume_ai.db

# Machine Learning Artifacts
MODEL_PATH=model/resume_classifier.joblib

# File Upload Settings (Default: 5 MB max size)
MAX_CONTENT_LENGTH=5242880
UPLOAD_FOLDER=uploads

# Server Settings
PORT=5000
HOST=0.0.0.0
